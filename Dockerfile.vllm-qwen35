# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE=runpod/worker-v1-vllm:nightly
FROM ${BASE_IMAGE}

# ---------------------------------------------------------------------------
# Pin vLLM to stable 0.17.0 (Qwen3.5 support: GDN, reasoning parser, FP8)
# ---------------------------------------------------------------------------
ARG VLLM_VERSION=0.17.0
RUN pip install --no-cache-dir \
        "vllm[flashinfer]==${VLLM_VERSION}" \
        --extra-index-url https://download.pytorch.org/whl/cu129

# ---------------------------------------------------------------------------
# Install CUDA compiler (nvcc) — required by FlashInfer to JIT-compile
# GDN (Gated Delta Network) kernels for Qwen3.5 at first startup.
# The base worker-vllm image is runtime-only and does not include nvcc.
# ---------------------------------------------------------------------------
RUN apt-get update && \
    apt-get install -y --no-install-recommends cuda-nvcc-12-9 && \
    rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Bake model weights into the image — eliminates ~30GB network download on
# every cold start. Loads from local NVMe instead.
#
# HF_TOKEN is mounted as BuildKit secret (NOT visible in image history).
# Pass via:  docker build --secret id=hf_token,env=HF_TOKEN ...
# Or in CI:  secrets: |  hf_token=${{ secrets.HF_TOKEN }}
# ---------------------------------------------------------------------------
ARG MODEL_REPO=Qwen/Qwen3.5-27B-FP8
ENV MODEL_PATH=/models/qwen3.5-27b-fp8

RUN pip install --no-cache-dir "huggingface_hub[hf_transfer]"
ENV HF_HUB_ENABLE_HF_TRANSFER=1

RUN --mount=type=secret,id=hf_token \
    HF_TOKEN=$(cat /run/secrets/hf_token) && \
    huggingface-cli download "${MODEL_REPO}" \
        --local-dir "${MODEL_PATH}" \
        --token "$HF_TOKEN" && \
    rm -rf /root/.cache/huggingface

# Default the model name to the baked path. Can still be overridden at runtime.
ENV MODEL_NAME=${MODEL_PATH}
